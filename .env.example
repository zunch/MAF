# Azure OpenAI Configuration (Rekommenderat för Microsoft Agent Framework)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Eller använd Azure AI Project (för Azure AI Agent Service)
# AZURE_AI_PROJECT_ENDPOINT=https://your-project.api.azureml.ms
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# OpenAI Configuration (Alternativ till Azure)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_ID=gpt-4o

# Vector Database Configuration
# Qdrant (för långtidsminne och RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Valfritt, lämna tom för lokal installation

# ChromaDB (alternativ till Qdrant)
CHROMA_PATH=./chroma_db
CHROMA_PERSIST=true

# Agent Configuration
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT_SECONDS=60

# Memory Configuration
SHORT_TERM_MEMORY_SIZE=10
LONG_TERM_MEMORY_ENABLED=true
MEMORY_RELEVANCE_THRESHOLD=0.7

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K_RESULTS=3
RAG_SIMILARITY_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
